{
  "manifest_version": 3,
  "name": "YC Hack",
  "version": "1.0",
  "description": "Display your 20 most recent sites visited",
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:3001/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open YC Hack"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "inlineBubble.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
