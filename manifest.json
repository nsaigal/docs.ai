{
  "manifest_version": 3,
  "name": "YC Hack",
  "version": "1.0",
  "description": "Display your 20 most recent sites visited",
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open YC Hack"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://localhost:3001/*"
  ]
}
